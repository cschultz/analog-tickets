# TEST beta configuration reference. All workflows are disabled when empty.
# Use the host's secure settings or a short-lived local process for real values.
# No live keys, real recipients, provider tokens or passwords belong in Git.
# Step 4 of docs/RELEASE_FIRST_RUN.md needs only the URL and publishable key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never rename these to VITE_* or place them in browser settings.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_TEST_RESTRICTED_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
MAILTRAP_API_TOKEN=

# Set these exactly as described in the first-run guide only for a TEST run.
GUEST_CHECKOUT_SANDBOX_MODE=
PROMOTION_PRICING_SANDBOX_MODE=
PAYMENTS_TEST_MODE=
PAYMENT_PROVIDER=
STAGING_ALLOWED_ORIGIN=
GUEST_RECOVERY_SANDBOX_MODE=
GUEST_ACCOUNT_SANDBOX_MODE=
ATTENDEE_PASS_SANDBOX_MODE=
CHECKIN_SANDBOX_MODE=
BOX_OFFICE_MODULE=

# Mailtrap Email Testing only; synthetic sender and example.test recipients.
MAILTRAP_TESTING_MODE=
MAILTRAP_ACCOUNT_ID=
MAILTRAP_INBOX_ID=
MAILTRAP_FROM_ADDRESS=
MAILTRAP_RECIPIENT_DOMAIN=
