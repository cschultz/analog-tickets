# Copy to `.env` and fill in values for YOUR OWN backend project.
# `.env` is git-ignored. Never commit real URLs, ids, keys, tokens or secrets.
#
# These three are the only client-side (public) variables the app requires.
# They are safe to expose in a browser bundle; row level security protects data.

VITE_SUPABASE_URL="https://<supabase-project-ref>.supabase.co"
VITE_SUPABASE_PROJECT_ID="<supabase-project-ref>"
VITE_SUPABASE_PUBLISHABLE_KEY="<publishable-anon-key>"

# ---------------------------------------------------------------------------
# Optional platform settings
# ---------------------------------------------------------------------------
# VITE_PLATFORM_MODE="integrated"        # site | ticketing | integrated
# VITE_EVENT_SLUG="<your-event-slug>"
# VITE_PRODUCTION_HOSTS="example.test,www.example.test"

# ---------------------------------------------------------------------------
# Optional analytics / advertising (OPT-IN)
# ---------------------------------------------------------------------------
# Leave these unset and the app loads NO tag manager, NO analytics, NO pixel
# and no third-party script, and contacts no tracking endpoint. Set them only
# with identifiers from accounts YOU control. They are public values compiled
# into the browser bundle — never put a secret here. Malformed values are
# ignored. Never commit real identifiers to this file.
#
# VITE_GTM_CONTAINER_ID="GTM-XXXXXXX"
# VITE_GA4_MEASUREMENT_ID="G-XXXXXXXXXX"
# VITE_GOOGLE_ADS_IDS="AW-000000000,AW-111111111"
# VITE_META_PIXEL_ID="000000000000000"
# VITE_CONTENT_SCRIPT_URL="https://<your-content-script-host>/content.js"

# Server-side secrets (API keys, webhook signing secrets, provider tokens) are
# NOT read from this file. Supply them to your backend/edge-function runtime
# through its own secret store. See docs/SECRETS_SETUP.md.

# ---------------------------------------------------------------------------
# Optional backend event row ids (OPT-IN)
# ---------------------------------------------------------------------------
# A few screens (lineup, registrations, event photos, lodging units, the
# sessions RSVP page) read a single event row by primary key. Point these at
# rows in YOUR backend. When unset they resolve to the nil UUID, so those
# queries return nothing instead of touching another operator's data.
#
# VITE_PRIMARY_EVENT_ID="00000000-0000-0000-0000-000000000000"
# VITE_LODGING_EVENT_ID="00000000-0000-0000-0000-000000000000"
# VITE_SESSIONS_EVENT_ID="00000000-0000-0000-0000-000000000000"
#
# Outbound links to real-world third parties (social accounts, producing
# organization, partner booking engines, store) are NOT env vars — edit
# src/platform/externalLinks.ts. They ship unset and render nothing.

# ---------------------------------------------------------------------------
# Backend / edge-function variables (server-side, NOT read from this file)
# ---------------------------------------------------------------------------
# Listed here for reference only. Supply them to your edge-function runtime
# through its own secret store — see docs/SECRETS_SETUP.md. Every one of them
# fails closed: unset means links point at the reserved, non-routable
# placeholder host `example.invalid`, mail is not sent, and event-scoped jobs
# read the nil UUID instead of another operator's rows.
#
# Required for a functioning deployment:
#   SITE_URL="https://<your-public-site>"          # no trailing slash
#
# Outbound email (unset => notification helpers send nothing):
#   OPERATOR_FROM_EMAIL="hello@<your-domain>"
#   OPERATOR_REPLY_TO_EMAIL="hello@<your-domain>"
#   OPERATOR_ALERT_EMAIL="alerts@<your-domain>"
#   OPERATOR_BRAND_NAME="<Your Event Team>"
#   OPERATOR_MAIL_DOMAIN="mail.<your-domain>"      # machine/threaded addresses
#   PLATFORM_ADMIN_EMAILS="a@<your-domain>,b@<your-domain>"
#   INTERNAL_EMAIL_PATTERNS="@<your-domain>,noreply@"
#
# Event row ids used by a few backend jobs (unset => nil UUID):
#   PRIMARY_EVENT_ID="00000000-0000-0000-0000-000000000000"
#   LODGING_EVENT_ID="00000000-0000-0000-0000-000000000000"
#   SESSIONS_EVENT_ID="00000000-0000-0000-0000-000000000000"
#
# Stripe price ids for checkout/canary paths (unset => that path is skipped):
#   STRIPE_PRICE_TIER_1_KREWE_3DAY="price_..."
#   STRIPE_PRICE_TIER_1_VIP_3DAY="price_..."
#   STRIPE_PRICE_TIER_1_GA_2DAY="price_..."
#   STRIPE_PRICE_PATRONS_ULTIMATE="price_..."
#   STRIPE_PRICE_PATRONS_PREMIER="price_..."
#   STRIPE_PRICE_DINNER_PARTY="price_..."
#   STRIPE_PRICE_PARTY_ONLY="price_..."
